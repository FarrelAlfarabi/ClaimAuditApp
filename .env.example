# Copy to .env.local on the demo laptop. .env.local is git-ignored.

# Supabase project "ruangguru-claim-audit-demo" (login only; claims data stays in local SQLite).
# Both values are public by design (they ship to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://nfcmhwkmnwhwtdcuwnfs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dFon1v5Eil8cpGAYodQA1A_5zAtSbQl

# Demo-only one-tap sign-in buttons on /login. The password stays on the server.
# Ask Farrel for the demo password; never commit it.
DEMO_QUICK_LOGIN=1
DEMO_PASSWORD=

# Kill switch: set to 1 to turn login off and fall back to the Employee/Finance switcher
# (e.g. the hotspot has no mobile data). Restart the server after changing it.
AUTH_DISABLED=0
